{
  "provider": "github",
  "defaultBaseBranch": "main",
  "repo": "0oWoodenDooro0/AiKanban",
  "branchPrefix": "feature/",
  "operator": "Antigravity",
  "verify": [
    "./gradlew test",
    "./gradlew ktlintCheck"
  ],
  "hooks": {
    "pre-commit": [
      "./gradlew ktlintFormat"
    ],
    "pre-submit-pr": [
      "./gradlew test ktlintCheck"
    ],
    "pre-complete-review": [
      "./gradlew test ktlintCheck"
    ]
  },
  "workflows": {
    "build": {
      "description": "Build standalone executable CLI binary",
      "steps": [
        "./gradlew buildExecutable"
      ]
    },
    "release": {
      "description": "Run test checks and build standalone binary",
      "steps": [
        "./gradlew test ktlintCheck",
        "./gradlew buildExecutable"
      ]
    },
    "install": {
      "description": "Build and install aikanban binary to ~/.local/bin",
      "steps": [
        "./gradlew installCli"
      ]
    },
    "format": {
      "description": "Format Kotlin source code using ktlint",
      "steps": [
        "./gradlew ktlintFormat"
      ]
    },
    "check": {
      "description": "Run unit test suite and ktlint verification",
      "steps": [
        "./gradlew test ktlintCheck"
      ]
    }
  },
  "workflow": {
    "mergeMethod": "squash",
    "deleteBranchOnMerge": true,
    "requireVerification": false,
    "checkoutBaseOnComplete": true,
    "requestColumn": "REQUEST",
    "doneColumn": "DONE",
    "reviewColumn": "REVIEW"
  }
}
